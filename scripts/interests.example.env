# Copy to .local/interests.env, chmod 600. Do not commit the populated file.
# Values are read literally; optional surrounding quotes are removed. No shell expansion.
LASTFM_API_KEY=
LASTFM_USERNAME=
STEAM_API_KEY=
STEAM_ID=
# Base URL including any HTTP root, e.g. http://127.0.0.1:8181
TAUTULLI_URL=
TAUTULLI_API_KEY=
# Required: only this user's completed movie plays are collected.
TAUTULLI_USER_ID=
# Header requires Tautulli >= 2.18. For older versions set this to query.
TAUTULLI_AUTH=header
LETTERBOXD_USERNAME=
